{
  "name": "bunzzle",
  "version": "0.3.0",
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "bin": {
    "bunzzle": "src/cli/main.ts"
  },
  "description": "Self-hosted email delivery engine for apps. Bun-native.",
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/cli/main.ts serve",
    "start": "bun src/cli/main.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "build": "bun build src/cli/main.ts --compile --minify --sourcemap --outfile dist/bunzzle",
    "openapi": "bun src/cli/main.ts openapi > openapi.json && bun sdk/generate.ts",
    "bench": "bun bench/queue.ts",
    "bench:fair": "bun bench/fair.ts",
    "crash": "bun bench/crash.ts"
  },
  "type": "module"
}
