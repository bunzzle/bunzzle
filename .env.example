# Address to listen on. Use 0.0.0.0 inside Docker.
BUNZZLE_HOST=127.0.0.1
BUNZZLE_PORT=3000

# Where the SQLite database lives.
BUNZZLE_DATA_DIR=./data

# debug | info | warn | error
BUNZZLE_LOG_LEVEL=info

# Sending. EHLO name must be the reverse DNS (PTR) name of the sending IP.
# BUNZZLE_EHLO_NAME=mail.example.com
# BUNZZLE_SOURCE_IP=203.0.113.7
# BUNZZLE_DKIM_KEY_FILE=./dkim.json

# Comma-separated DNS resolvers. Default: /etc/resolv.conf
# BUNZZLE_DNS_SERVERS=1.1.1.1,9.9.9.9

# Also deliver over IPv6 (only with reverse DNS for the IPv6 address).
BUNZZLE_IPV6=false

# Master key: encrypts DKIM keys and every email body. Create one with `bunzzle master-key`.
# Prefer a file readable only by Bunzzle. Losing it makes stored keys and queued email unreadable.
# BUNZZLE_MASTER_KEY_FILE=/etc/bunzzle/master.key
# BUNZZLE_MASTER_KEY=

# Signer's directory: the encrypted key store and DKIM key files (keys/dkim/*.json).
BUNZZLE_KEYS_DIR=./keys

# Unix sockets the roles use to talk to each other.
BUNZZLE_RUN_DIR=./run

# Email bodies become unreadable after this many days, even in old backups. Minimum 7.
BUNZZLE_RETENTION_DAYS=30

# Bounces, complaints and unsubscribe mail. Off unless a port is set; 25 in production.
# BUNZZLE_INBOUND_PORT=25

# Name of this server in the bounce MX records (default: BUNZZLE_EHLO_NAME).
# BUNZZLE_INBOUND_HOSTNAME=mail.example.com

# Public https URL of the API, used in one-click unsubscribe links of bulk email.
# BUNZZLE_PUBLIC_URL=https://mail.example.com

# Sending IPs, comma-separated; add =bulk to put an IP in the bulk pool.
# BUNZZLE_SOURCE_IPS=203.0.113.7,203.0.113.8=bulk
# IPs with an existing good reputation skip warm-up.
# BUNZZLE_ESTABLISHED_IPS=203.0.113.7

# DKIM keys rotate automatically after this many days.
BUNZZLE_DKIM_ROTATE_DAYS=90

# Cloudflare API token with DNS edit rights: Bunzzle publishes the records it owns.
# BUNZZLE_CLOUDFLARE_API_TOKEN=
