# Address to listen on. Use 0.0.0.0 inside Docker.
BUNZZLE_HOST=127.0.0.1
BUNZZLE_PORT=3000

# Where the SQLite database lives.
BUNZZLE_DATA_DIR=./data

# debug | info | warn | error
BUNZZLE_LOG_LEVEL=info

# Sending. EHLO name must be the reverse DNS (PTR) name of the sending IP.
# BUNZZLE_EHLO_NAME=mail.example.com
# BUNZZLE_SOURCE_IP=203.0.113.7
# BUNZZLE_DKIM_KEY_FILE=./dkim.json

# Comma-separated DNS resolvers. Default: /etc/resolv.conf
# BUNZZLE_DNS_SERVERS=1.1.1.1,9.9.9.9

# Also deliver over IPv6 (only with reverse DNS for the IPv6 address).
BUNZZLE_IPV6=false
