table inet bunzzle {
  set node_links4 {
    type ipv4_addr . inet_service
  }

  set node_links6 {
    type ipv6_addr . inet_service
  }

  set core4 {
    type ipv4_addr
  }

  set core6 {
    type ipv6_addr
  }

  set link_ports {
    type inet_service
  }

  chain input {
    type filter hook input priority filter; policy accept;
    tcp dport @link_ports ip saddr @core4 accept
    tcp dport @link_ports ip6 saddr @core6 accept
    tcp dport @link_ports counter drop
  }

  chain output {
    type filter hook output priority filter; policy accept;
    ct state established,related accept
    oifname "lo" accept
    meta skuid "bunzzle-core" ip daddr . tcp dport @node_links4 accept
    meta skuid "bunzzle-core" ip6 daddr . tcp dport @node_links6 accept
    meta skuid { "bunzzle-signer", "bunzzle-core", "bunzzle-api", "bunzzle-inbound" } counter drop
    meta skuid "bunzzle-delivery" udp dport 53 accept
    meta skuid "bunzzle-delivery" tcp dport { 25, 53, 443 } accept
    meta skuid "bunzzle-delivery" counter drop
    meta skuid "bunzzle-dns" udp dport 53 accept
    meta skuid "bunzzle-dns" tcp dport { 53, 443 } accept
    meta skuid "bunzzle-dns" counter drop
  }
}
