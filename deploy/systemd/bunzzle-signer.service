[Unit]
Description=Bunzzle signer: DKIM keys and body decryption, no network
Documentation=https://github.com/bunzzle/bunzzle/blob/main/docs/install.md
PartOf=bunzzle.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=bunzzle-signer
Group=bunzzle-signer
EnvironmentFile=/etc/bunzzle/bunzzle.env
Environment=BUNZZLE_RUN_DIR=/run/bunzzle
ExecStart=/usr/local/bin/bunzzle role signer
Restart=always
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=5
TimeoutStartSec=30
TimeoutStopSec=15
LoadCredential=master.key:/etc/bunzzle/master.key
Environment=BUNZZLE_MASTER_KEY_FILE=%d/master.key
StateDirectory=bunzzle/keys
StateDirectoryMode=0700
Environment=BUNZZLE_KEYS_DIR=/var/lib/bunzzle/keys
ReadWritePaths=/run/bunzzle
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ExecStartPost=/bin/sh -c 'until [ -S /run/bunzzle/signer.sock ]; do sleep 0.1; done'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @obsolete @cpu-emulation @clock @module @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=bunzzle.target
