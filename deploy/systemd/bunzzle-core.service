[Unit]
Description=Bunzzle core: queue, scheduler and database, no network
Documentation=https://github.com/bunzzle/bunzzle/blob/main/docs/install.md
PartOf=bunzzle.target
StartLimitIntervalSec=0
After=bunzzle-signer.service bunzzle-dns.service

[Service]
Type=exec
User=bunzzle-core
Group=bunzzle-core
EnvironmentFile=/etc/bunzzle/bunzzle.env
Environment=BUNZZLE_RUN_DIR=/run/bunzzle
Environment=BUNZZLE_ENV_FILE=/etc/bunzzle/bunzzle.env
Environment=BUNZZLE_INBOUND_SOCKET_GROUP=bunzzle-core-inbound
ExecStart=/usr/local/bin/bunzzle role core
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=5
TimeoutStartSec=30
TimeoutStopSec=15
StateDirectory=bunzzle/data
StateDirectoryMode=0700
Environment=BUNZZLE_DATA_DIR=/var/lib/bunzzle/data
LogsDirectory=bunzzle/events
LogsDirectoryMode=0750
Environment=BUNZZLE_EVENT_LOG_DIR=/var/log/bunzzle/events
ReadWritePaths=/run/bunzzle
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ExecStartPost=/bin/sh -c 'until [ -S /run/bunzzle/core.sock ]; do sleep 0.1; done'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @obsolete @cpu-emulation @clock @module @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=bunzzle.target
