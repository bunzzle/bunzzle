[Unit]
Description=Bunzzle email delivery engine
Documentation=https://github.com/bunzzle/bunzzle/blob/main/docs/install.md
Wants=bunzzle-signer.service bunzzle-dns.service bunzzle-core.service bunzzle-delivery.service bunzzle-api.service bunzzle-inbound.service
After=network-online.target
Wants=network-online.target

[Install]
WantedBy=multi-user.target
